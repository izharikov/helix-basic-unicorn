<?xml version="1.0"?>

<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <mvc>
      <precompilation>
        <assemblies>
          <assemblyIdentity name="BasicCompany.Feature.Search" />
        </assemblies>
      </precompilation>
    </mvc>
    <pipelines>
      <initialize>
        <processor type="BasicCompany.Feature.Search.Pipelines.RegisterRoutes, BasicCompany.Feature.Search"
                   patch:before="processor[@type='Sitecore.Mvc.Pipelines.Loader.InitializeRoutes, Sitecore.Mvc']" />
      </initialize>
    </pipelines>
    <services>
      <configurator type="BasicCompany.Feature.Search.ServicesConfigurator, BasicCompany.Feature.Search" />
    </services>
  </sitecore>
</configuration>
