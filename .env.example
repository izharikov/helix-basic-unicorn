COMPOSE_PROJECT_NAME=helix-sample
REGISTRY=
VERSION=

SOLUTION_BUILD_IMAGE=mcr.microsoft.com/dotnet/framework/sdk:4.8-windowsservercore-ltsc2022
SOLUTION_BASE_IMAGE=mcr.microsoft.com/windows/nanoserver:ltsc2022
BUILD_CONFIGURATION=debug

LOCAL_DEPLOY_PATH=.\docker\deploy
LOCAL_DATA_PATH=.\docker\data
LOCAL_ITEM_PATH=.\src
UNICORN_SHARED_SECRET=
UNICORN_ENABLE_TRANSPARENT_SYNC=true
HOST_LICENSE_FOLDER=.\docker\license

CD_HOST=cd.helix-sample.com
CM_HOST=cm.helix-sample.com
ID_HOST=id.helix-sample.com
SITE_HOST=www.helix-sample.com
CM_SITE_HOST=preview.helix-sample.com
SITE_DATABASE=web
CM_SITE_DATABASE=master

SITECORE_DOCKER_REGISTRY=scr.sitecore.com/sxp/
SITECORE_TOOLS_REGISTRY=scr.sitecore.com/tools/
SITECORE_VERSION=10.4.1-ltsc2022
SITECORE_ID_VERSION=8.0-ltsc2022
TOOLS_VERSION=10.4.0-ltsc2022
EXTERNAL_IMAGE_TAG_SUFFIX=ltsc2022
SOLR_VERSION=9.8.1
REDIS_VERSION=3.2.100
MSSQL_VERSION=2017

SQL_SERVER=mssql
SQL_SA_LOGIN=sa
SQL_DATABASE_PREFIX=Sitecore
SQL_CUSTOM_DATABASE_PREFIX_UPDATE_FROM=

SITECORE_ADMIN_PASSWORD=
SQL_SA_PASSWORD=
SOLR_CORE_PREFIX_NAME=sitecore
TELERIK_ENCRYPTION_KEY=
SITECORE_IDSECRET=
SITECORE_ID_CERTIFICATE=
SITECORE_ID_CERTIFICATE_PASSWORD=
# Because we are using a mounted license file, this value can be empty.
# Included here to suppress 'variable is not set' warning from docker-compose.
SITECORE_LICENSE=
TRAEFIK_IMAGE=traefik:v3.6.7-windowsservercore-ltsc2022
TRAEFIK_ISOLATION=hyperv
ISOLATION=process
MEDIA_REQUEST_PROTECTION_SHARED_SECRET=
LOG_LEVEL_VALUE=INFO

SITECORE_GRAPHQL_ENABLED=true
SITECORE_GRAPHQL_EXPOSEPLAYGROUND=false
SITECORE_GRAPHQL_UPLOADMEDIAOPTIONS_ENCRYPTIONKEY=
